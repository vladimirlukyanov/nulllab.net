---
import { MobileMenu } from '~/components/header/index.ts'
---

<div id="main_mobile_menu" class="menu main">
    <div class="overlay show blurred">
        <div class="section">
            <MobileMenu/>
        </div>
    </div>
</div>

<style lang="scss">
  @use "sass:list";
  @use "sass:meta";
  @use "sass:string";

  @use '~/styles/app.scss' as app;

  // ↓ Overlay
  @use '@nulllogic/scssleon/scss/components/overlay' with (
      $config: app.$config,
      $theme: app.$theme
  );

  $menu: (
    position: fixed,
    top: 0,
    left: 0,
    bottom: 0,
    width: 100%,
    height: auto,
    z-index : app.get-config(app.$config, 'z-index.header'),
    display: block,
    transition: string.unquote('display .32s ease-in allow-discrete'),
    _subclasses : (
      '&.main' : (
        top: 47px,
        _subclasses : (
          '.overlay' : (
            --align-items : start,
            --justify-content: start,
            transition: string.unquote("opacity .32s cubic-bezier(.4,0,.6,1) 80ms, visibility .32s"),
            opacity: 0,
            visibility: hidden,
            _atrule : (
              '@starting-style' : (
                opacity: 0,
                visibility: hidden,
              )
            ),
            _subclasses : (
              '.section' : (
                padding-inline: var(--padding-inline),
                padding-block: 20px,
                border: none,
                border-radius: 0,
                width: 100%,
                overflow-y: scroll,
                _responsive : (
                  sm : (
                    max-width: 410px,
                  )
                )
              )
            )
          )
        )
      ),
      '&.show' : (
        display: block,
        transition: string.unquote('display .32s ease-out allow-discrete'),
        opacity: 1,
        _subclasses : (
          '.overlay' : (
            opacity: 1,
            visibility: visible,
            transition: string.unquote("opacity .32s cubic-bezier(.4,0,.6,1) 80ms, visibility .32s step-start 80ms"),
          )
        ),
        _responsive : (
          lg : (
            display: none,
          )
        )
      ),
    )
  );

  @include app.generate-component(
    $menu,
    'menu',
    app.$config,
    app.$theme,
    (variable: (exclude : 'overlay'))
  );
</style>