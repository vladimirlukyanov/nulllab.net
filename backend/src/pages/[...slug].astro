                                display: inline-block,
                              )
                            )
                          )
                        )
                      ),
                      '.published_date' : (
                        _subclasses: (
                          '&:before' : (
                            content : '·',
                            display: none,
                            padding-right: .25rem,
                            _responsive : (
                              md : (
                                display: inline-block,
                              )
                            )
                          )
                        )
                      ),
                      '.updated_date' : (
                        _subclasses: (
                          '&:before' : (
                            content : '·',
                            display: none,
                            padding-right: .25rem,
                            _responsive : (
                              md : (
                                display: inline-block,
                              )
                            )
                          )
                        )
                      )
                    ),
                    _responsive : (
                      md : (
                        grid-template-columns: auto auto 1fr,
                        grid-template-rows: auto,
                      )
                    )
                  )
                ),
                _responsive : (
                  lg : (
                    grid-template-columns: auto 1fr,
                    grid-template-rows: auto,
                  )
                )
              ),
              '.information': (
                display: flex,
                align-items: center,
                margin: 0 0 10px 0,
                /***/
                _subclasses: (
                  '.tags': (
                    margin: 0 10px,
                    display: flex,
                    gap: 10px,
                    text-transform: capitalize,
                  ),
                ),
              ),
              '.description': (
                /*font-size: 1.25rem,*/
                /*color: #ccc,*/
              ),
            )
          ),
          '.sidebar': (
          )
        )
      ),
    ),
  );

  @include mixins.generate-component(
    $single_post,
    '.single_post',
    app.$config,
    app.$theme
  );
</style>