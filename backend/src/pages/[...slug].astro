  @use "sass:string";
  @use "sass:meta";
  @use "sass:map";

  @use "~/styles/app.scss" as app;

  @use "~/styles/scss/mixins.scss" as mixins;
  @use "~/styles/scss/functions.scss" as functions;

  $single_post: (
    margin: 25px 0,
    /***/
    _subclasses: (
      '.grid' : (
        display: grid,
        width: 100%,
        grid-template-columns: 1fr,
        grid-auto-rows: auto,
        grid-gap: 1rem,
        /***/
        _responsive: (
          md: (
            grid-template-columns: 1.4fr 0.6fr,
            grid-gap: 2rem,
          ),
        ),
        /***/
        _subclasses: (
          '.post' : (
            /***/
