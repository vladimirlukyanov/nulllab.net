              '.category' : (
                text-transform: capitalize,
                display: flex,
                margin: 0 0 .25rem 0,
                _subclasses: (
                  '.link' : (
                    color: #8c602e,
                  )
                )
              ),
              '.title': (),
              '.info': (
                display: grid,
                gap: .5rem,
                grid-template-columns: 1fr,
                grid-template-rows: auto,
                margin: 0 0 1.5rem 0,
                _subclasses: (
                  '.authors' : (
                    display: flex,
                    align-items: center,
                    gap: .5rem,
                    _subclasses: (
                      '.author' : (
